{
  "name": "koruva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "vite",
    "build:client": "vite build",
    "build": "npm run typecheck && npm run build:client",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p src/client && tsc -p src/worker",
    "test": "tsx test/core.test.ts && tsx test/physics.test.ts && tsx --tsconfig test/tsconfig.json test/room.test.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
